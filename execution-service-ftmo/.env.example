# cTrader Open API application credentials
# Register an app at https://openapi.ctrader.com to get these two values,
# and register CTRADER_REDIRECT_URI there too (must match exactly).
CTRADER_CLIENT_ID=REPLACE_ME
CTRADER_CLIENT_SECRET=REPLACE_ME
CTRADER_REDIRECT_URI=http://localhost:5052/callback

# demo or live. cTrader's demo/live are fully separate account universes —
# switching requires CONFIRM_LIVE=true below as a deliberate second step.
# FTMO's free-trial account is a 14-day simulated evaluation account, which
# is a demo-type account under the hood regardless of what FTMO calls it —
# leave this as demo unless you have a real, funded FTMO account.
CTRADER_ENVIRONMENT=demo
CONFIRM_LIVE=false

# Obtained by running `python get_access_token.py` once (see README) — leave
# blank until you've done that.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Optional: pin a specific ctidTraderAccountId (get_access_token.py prints
# the available ones). Leave blank to auto-pick the one matching
# CTRADER_ENVIRONMENT, if there's exactly one.
CTRADER_ACCOUNT_ID=

# Instrument — confirm this is actually offered on your FTMO account before
# relying on it; get_access_token.py / the standalone test log the resolved
# symbol's digits/lotSize/volume constraints so you can sanity-check TICK_SIZE.
SYMBOL_NAME=XAUUSD
TICK_SIZE=0.01

# Order defaults (used only if a TradingView alert omits lot/tp/sl).
# DEFAULT_LOT is in cTrader lots, NOT IBKR contracts. Deliberately small
# here; size this up only once you understand the notional exposure it
# represents, and check it against your account's actual margin/balance.
DEFAULT_LOT=0.01
DEFAULT_TP_TICKS=400
DEFAULT_SL_TICKS=400

# Webhook (same contract as the IBKR/Pepperstone versions)
WEBHOOK_SECRET=REPLACE_ME
EXECUTION_SERVICE_HOST=0.0.0.0
EXECUTION_SERVICE_PORT=8002
DEDUP_WINDOW_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/trading_system.log

# Telegram notifications (same contract as the other services)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
