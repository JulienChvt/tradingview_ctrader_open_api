# Secrets — never commit real values
execution-service/.env
execution-service-pepperstone/.env
execution-service-ftmo/.env

# Python
execution-service/venv/
execution-service/__pycache__/
execution-service/**/__pycache__/
execution-service/*.pyc
execution-service-pepperstone/venv/
execution-service-pepperstone/__pycache__/
execution-service-pepperstone/**/__pycache__/
execution-service-pepperstone/*.pyc
execution-service-ftmo/venv/
execution-service-ftmo/__pycache__/
execution-service-ftmo/**/__pycache__/
execution-service-ftmo/*.pyc
manager/venv/
manager/__pycache__/
manager/**/__pycache__/
manager/*.pyc

# Logs
execution-service/logs/*.log*
execution-service-pepperstone/logs/*.log*
execution-service-ftmo/logs/*.log*
manager/logs/*.log*

# Generated by manager/process_manager.py — not source, regenerated on start
manager/ngrok_endpoints.yml

# Generated by manager/manage.sh
manager/manager.pid
