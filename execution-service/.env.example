# IBKR connection
# Paper: TWS=7497, IB Gateway=4002. Live: TWS=7496, IB Gateway=4001.
IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
# Must be explicitly set to true to allow connecting to a live-trading port (7496/4001).
CONFIRM_LIVE=false

# Instrument
FUTURES_SYMBOL=MGC
FUTURES_EXCHANGE=COMEX
FUTURES_CURRENCY=USD
TICK_SIZE=0.10
# Optional override, format YYYYMM. Leave blank to auto-resolve the front month.
FUTURES_CONTRACT_MONTH=
# IBKR blocks new orders on physically-settled futures (gold included) this many
# days before expiry (its near-expiry/physical-delivery risk policy) — auto
# front-month resolution skips any contract closer to expiry than this.
FRONT_MONTH_MIN_DAYS_OUT=30

# Order defaults (used only if a TradingView alert omits lot/tp/sl)
DEFAULT_LOT=5
DEFAULT_TP_TICKS=40
DEFAULT_SL_TICKS=40

# Webhook (this service receives TradingView alerts directly at /webhook —
# set this in the TradingView alert's X-Webhook-Secret header, or as a
# ?secret= query param on the webhook URL if a custom header isn't possible)
WEBHOOK_SECRET=REPLACE_ME
EXECUTION_SERVICE_HOST=0.0.0.0
EXECUTION_SERVICE_PORT=8000
DEDUP_WINDOW_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/trading_system.log

# Telegram notifications (required — trade opened + errors, see section 4.8)
TELEGRAM_BOT_TOKEN=REPLACE_ME
TELEGRAM_CHAT_ID=REPLACE_ME
