# cTrader Open API application credentials
# Register an app at https://openapi.ctrader.com to get these two values,
# and register CTRADER_REDIRECT_URI there too (must match exactly).
CTRADER_CLIENT_ID=REPLACE_ME
CTRADER_CLIENT_SECRET=REPLACE_ME
CTRADER_REDIRECT_URI=http://localhost:5000/callback

# demo or live. cTrader's demo/live are fully separate account universes —
# switching requires CONFIRM_LIVE=true below as a deliberate second step.
CTRADER_ENVIRONMENT=demo
CONFIRM_LIVE=false

# Obtained by running `python get_access_token.py` once (see README) — leave
# blank until you've done that.
CTRADER_ACCESS_TOKEN=
CTRADER_REFRESH_TOKEN=
# Optional: pin a specific ctidTraderAccountId (get_access_token.py prints
# the available ones). Leave blank to auto-pick the one matching
# CTRADER_ENVIRONMENT, if there's exactly one.
CTRADER_ACCOUNT_ID=

# Instrument — Pepperstone's cTrader gold symbol is a spot CFD (XAUUSD), not
# a COMEX future like the IBKR version's MGC/GC. TICK_SIZE is the price
# increment used to convert `tp`/`sl` ticks into cTrader's relative SL/TP
# unit; 0.01 matches a typical 2-decimal XAUUSD quote, confirm against your
# account's actual symbol precision (get_access_token.py / the standalone
# test log the resolved symbol's digits).
SYMBOL_NAME=XAUUSD
TICK_SIZE=0.01

# Order defaults (used only if a TradingView alert omits lot/tp/sl).
# DEFAULT_LOT is in cTrader lots, NOT IBKR contracts — the two are not
# comparable exposure-wise (1 standard XAUUSD lot = 100 oz). Deliberately
# small here; size this up only once you understand the notional exposure
# it represents on your account.
DEFAULT_LOT=0.01
DEFAULT_TP_TICKS=400
DEFAULT_SL_TICKS=400

# Webhook (same contract as the IBKR version's execution-service)
WEBHOOK_SECRET=REPLACE_ME
EXECUTION_SERVICE_HOST=0.0.0.0
EXECUTION_SERVICE_PORT=8001
DEDUP_WINDOW_SECONDS=5

# Logging
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs/trading_system.log

# Telegram notifications (same contract as the IBKR version)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
